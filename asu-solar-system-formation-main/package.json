{
  "name": "asu-solar-system-formation",
  "version": "0.1.6",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--openssl-legacy-provider next dev",
    "build": "NODE_OPTIONS=--openssl-legacy-provider next build && next export",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "zip": "rm -rf out pages/demo*.tsx && NEXT_PUBLIC_BASE_PATH='/solar-system-formation' yarn build && zip -r asu-solar-system-formation.zip out && git checkout -- 'pages/demo*.tsx'"
  },
  "dependencies": {
    "@material-ui/core": "^5.0.0-beta.4",
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@nivo/core": "^0.73.0",
    "@nivo/line": "^0.73.0",
    "@typescript-eslint/eslint-plugin": "^4.29.1",
    "d3-shape": "^1.3.5",
    "lodash": "^4.17.21",
    "mobx": "^6.3.2",
    "mobx-react-lite": "^3.2.0",
    "next": "11.1.0",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-resize-detector": "^6.7.6",
    "styled-components": "^5.3.0"
  },
  "devDependencies": {
    "@types/d3-shape": "^1.3.5",
    "@types/jest": "^27.0.1",
    "@types/lodash": "^4.14.172",
    "@types/react": "17.0.17",
    "@types/styled-components": "^5.1.12",
    "eslint": "7.32.0",
    "eslint-config-next": "11.1.0",
    "jest": "^27.0.6",
    "typescript": "4.3.5"
  },
  "jest": {
    "moduleDirectories": [
      "node_modules"
    ],
